# From LINE Developers Console > your Messaging API channel
# Basic settings tab > Channel secret
LINE_CHANNEL_SECRET=
# Messaging API tab > Channel access token (long-lived) > Issue
LINE_CHANNEL_ACCESS_TOKEN=

# From https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# DEFAULT_TARGET_LANGUAGE=English
# DEFAULT_SECONDARY_LANGUAGE=Thai

# Morning news (optional overrides)
# NEWS_TIME=07:00
# NEWS_TIMEZONE=Asia/Bangkok
# NEWS_LANGUAGE=English
# NEWS_STORY_COUNT=5

PORT=3000

# Production (docker compose): public domain for the webhook, e.g. bot.example.com
DOMAIN=
