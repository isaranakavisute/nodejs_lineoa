# From LINE Developers Console > your Messaging API channel
# Basic settings tab > Channel secret
LINE_CHANNEL_SECRET=
# Messaging API tab > Channel access token (long-lived) > Issue
LINE_CHANNEL_ACCESS_TOKEN=

# From https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# DEFAULT_TARGET_LANGUAGE=English
# DEFAULT_SECONDARY_LANGUAGE=Thai

# Morning news: the daily push is off unless this is true (/news on demand always works)
# NEWS_SCHEDULE_ENABLED=true
# NEWS_TIME=07:00
# NEWS_TIMEZONE=Asia/Bangkok
# NEWS_LANGUAGE=English
# NEWS_STORY_COUNT=5

# Calendar alerts (optional; see README "Calendar alerts")
# MICROSOFT_CLIENT_ID=
# CALENDAR_ALERT_TO=U...your LINE user ID...
# CALENDAR_ALERT_MINUTES=60
# CALENDAR_TIMEZONE=Asia/Bangkok
# Name under standard email responses (Reply / Reply all / Forward from /inbox). Empty = no name.
# EMAIL_SIGNATURE=Isara Nakavisute

# Facebook Page posting (optional; see README "Posting to Facebook")
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=

PORT=3000

# Production (docker compose): public domain for the webhook, e.g. bot.example.com
DOMAIN=
